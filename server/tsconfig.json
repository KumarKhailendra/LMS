{
    "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "typeRoots": ["./node_modules/@types", "./types"],
      "forceConsistentCasingInFileNames": true
    },
    "include": [
      "./**/*.ts", 
      "./types/**/*.d.ts"
    ]
}